{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "policy", "decisions"],
  "properties": {
    "batchId": { "type": "string" },
    "policy": { "const": "tibo-quota-v1" },
    "decisions": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["postId", "kind", "confidence", "title", "summary", "reason", "evidence", "confirms", "duplicateOf"],
        "properties": {
          "postId": { "type": "string", "pattern": "^[0-9]{1,25}$" },
          "kind": { "enum": ["quota_reset", "quota_announcement", "quota_teaser", "ordinary"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "title": { "type": "string", "maxLength": 120 },
          "summary": { "type": "string", "maxLength": 600 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
          "evidence": { "type": "array", "maxItems": 4, "items": {
            "type": "object", "additionalProperties": false, "required": ["postId", "quote"],
            "properties": { "postId": { "type": "string" }, "quote": { "type": "string", "minLength": 1, "maxLength": 1000 } }
          } },
          "confirms": { "type": ["string", "null"] },
          "duplicateOf": { "type": ["string", "null"] }
        }
      }
    }
  }
}
